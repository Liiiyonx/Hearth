{
  "name": "uninvited",
  "version": "0.1.0",
  "description": "不请自来 Uninvited —— 你没请它来，它自己来的桌面小人。文档与论文永远留在你的电脑里。",
  "main": "out/main/index.js",
  "author": "Uninvited",
  "license": "MIT",
  "private": true,
  "scripts": {
    "app": "npm run build && node scripts/run-app.mjs",
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "dist": "npm run build && node scripts/prepare-win-codesign.mjs && electron-builder --win nsis",
    "pack": "npm run build && node scripts/prepare-win-codesign.mjs && electron-builder --dir && node scripts/prune-locales.mjs",
    "postinstall": "electron-builder install-app-deps",
    "probe:packaged": "node scripts/probe-packaged.mjs",
    "start": "electron-vite preview",
    "test:convert": "node scripts/node-convert-check.mjs",
    "test:regression": "npm run build && node scripts/run-regression.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.24.2",
    "@rollup/rollup-win32-x64-msvc": "^4.28.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "docx": "^9.0.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.8.69",
    "pixi.js": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
